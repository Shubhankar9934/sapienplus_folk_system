# FOLK AI Council - API credentials
# Copy this file to ".env" and fill in real keys before running calibrate/run.
# The pipeline also has an offline MOCK provider that needs no keys (see README).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set to "mock" to force the deterministic offline provider for every agent,
# or "live" to use the real APIs. Default is "live".
FOLK_PROVIDER_MODE=live
